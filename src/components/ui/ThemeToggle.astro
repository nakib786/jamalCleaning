---
/**
 * Light / dark theme button (behaviour: src/scripts/theme.ts; colours: src/styles/global.css).
 * A toggle button named "Dark mode": pressed while the dark theme is on. It shows a moon in the
 * light theme and a sun in the dark theme (the theme a click switches to); the icon follows
 * <html data-theme>, which is set before first paint, so it never shows the wrong one.
 *
 *   variant "icon"  round glass button for the header (on the dark hero / page banner)
 *   variant "row"   full-width row with a label and a switch, for the mobile menu
 *
 * Hidden without JavaScript, where it could not do anything. Its `display` comes from the styles
 * below, so to show it only at some widths wrap it (e.g. `<div class="hidden xl:block">`).
 */
interface Props {
  variant?: "icon" | "row";
  class?: string;
}

const { variant = "icon", class: className } = Astro.props;
const row = variant === "row";
---

<button
  type="button"
  class:list={[
    "theme-toggle",
    row
      ? "w-full items-center justify-between gap-3 py-3 text-base font-bold text-heading hover:text-primary"
      : "size-14 items-center justify-center rounded-full border border-white/[0.09] bg-[#d8dadf21] text-white backdrop-blur-[60px] transition-colors duration-300 hover:text-primary",
    className,
  ]}
  aria-label={row ? undefined : "Dark mode"}
  aria-pressed="false"
  data-theme-toggle
>
  <span class:list={[row && "flex items-center gap-3"]}>
    <svg
      class="theme-icon theme-icon-moon"
      viewBox="0 0 24 24"
      width={row ? 18 : 21}
      height={row ? 18 : 21}
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 14.2A8.3 8.3 0 0 1 9.8 4a8.3 8.3 0 1 0 10.2 10.2Z"></path>
    </svg>
    <svg
      class="theme-icon theme-icon-sun"
      viewBox="0 0 24 24"
      width={row ? 18 : 21}
      height={row ? 18 : 21}
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
    </svg>
    {row && <span>Dark mode</span>}
  </span>
  {row && (
    <span class="theme-switch" aria-hidden="true">
      <span class="theme-switch-knob" />
    </span>
  )}
</button>

<style>
  /* Display is set here, not with utilities, so the no-JavaScript rule below can hide the button. */
  .theme-toggle {
    display: flex;
  }
  :global(html.no-js) .theme-toggle {
    display: none;
  }

  .theme-icon {
    flex: none;
  }
  .theme-icon-sun {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }
  :global(html[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  /* Switch on the menu row: grey track, gold when the dark theme is on (the white knob has
     3:1+ against both). */
  .theme-switch {
    position: relative;
    width: 44px;
    height: 24px;
    flex: none;
    border-radius: 12px;
    background-color: #7f8388;
    transition: background-color 0.2s ease;
  }
  .theme-switch-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: #fff;
    transition: transform 0.2s ease;
  }
  :global(html[data-theme="dark"]) .theme-switch {
    background-color: var(--color-primary-strong);
  }
  :global(html[data-theme="dark"]) .theme-switch-knob {
    transform: translateX(20px);
  }
</style>
