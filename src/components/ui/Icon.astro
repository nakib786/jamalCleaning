---
/**
 * Theme icon as inline SVG (paths extracted from the Cetro icon font).
 * Sized by font-size like the original icon font: 1em tall, currentColor fill.
 */
import { ICONS, type IconName } from "./icons.generated";

interface Props {
  name: IconName;
  class?: string;
  /** Accessible label; omit for decorative icons. */
  label?: string;
}

const { name, class: className, label } = Astro.props;
const icon = ICONS[name];
---

<svg
  class:list={["inline-block h-[1em] w-auto shrink-0 fill-current align-middle", className]}
  viewBox={`0 0 ${icon.w} 1000`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"><path d={icon.d}></path></svg
>
