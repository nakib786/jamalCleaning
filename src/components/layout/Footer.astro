---
/** Site footer (Cetro footer template): newsletter, four columns, copyright bar. */
import { Image } from "astro:assets";
import footerBg from "../../assets/images/footer/footer-background.jpg";
import { isSet, site, whatsappLink } from "../../config/site";
import NewsletterForm from "../forms/NewsletterForm.astro";
import Icon from "../ui/Icon.astro";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
const { contact } = site;
---

<footer class="relative isolate overflow-hidden bg-secondary pt-[118px] text-white max-sm:pt-20">
  <Image
    src={footerBg}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 -z-10 size-full object-cover"
    aria-hidden="true"
  />
  <div class="absolute inset-0 -z-10 bg-[#000509bd]" aria-hidden="true"></div>

  <div class="section-gutter">
    <div class="site-container">
      <div class="mx-auto flex max-w-[690px] flex-col items-center gap-11 pb-[100px] max-sm:pb-[60px]">
        <h2 class="display-heading max-w-[550px] text-center text-white text-[30px] leading-[48px] sm:text-[40px] sm:leading-16">
          Join our <span class="accent">newsletter stay up to</span> date
        </h2>
        <NewsletterForm />
      </div>

      <div class="flex flex-wrap justify-between gap-x-[70px] gap-y-12 border-t border-white/10 pt-[90px] pb-[122px] max-sm:pt-[60px] max-sm:pb-[60px]">
        <div class="flex w-full flex-col gap-[26px] sm:w-[300px]">
          <Logo height={64} loading="lazy" />
          <p class="leading-6 text-white">{site.about}</p>
        </div>

        <nav aria-label="Footer" class="hidden lg:block">
          <ul class="flex flex-col gap-[10px]">
            {site.footerNav.map((item) => (
              <li>
                <a href={item.href} class="text-lg leading-6 font-bold text-white hover:text-primary">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex w-full flex-col gap-[25px] sm:w-[230px]">
          <h2 class="font-heading text-lg leading-[28.8px] text-white capitalize">Working Time</h2>
          <ul class="flex flex-col gap-[13px] text-lg leading-6 font-medium">
            {contact.hours.rows.map((row) => (
              <li>
                {row.label}: {row.value}
              </li>
            ))}
          </ul>
        </div>

        <div class="flex w-full flex-col gap-4 sm:w-[340px]">
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-[10px] text-lg leading-6 font-bold text-white hover:text-primary"
          >
            <WhatsAppIcon class="text-2xl text-primary" />
            <span>Chat on WhatsApp</span>
          </a>
          <a
            href={contact.phone.href}
            class="font-heading text-lg leading-6 text-primary underline underline-offset-2 hover:text-white"
          >
            {contact.phone.display}
          </a>
          <a
            href={`mailto:${contact.email}`}
            class="text-[22px] leading-[37.33px] font-semibold whitespace-nowrap text-white hover:text-primary xl:text-[24px]"
          >
            {contact.email}
          </a>
          <a
            href={contact.address.mapUrl}
            target="_blank"
            rel="noopener"
            class="flex items-start gap-[10px] text-base leading-[21.33px] font-semibold text-white hover:text-primary"
          >
            <Icon name="location-alt" class="mt-0.5 text-xl text-primary" />
            <span>
              {isSet(contact.address.street) && <>{contact.address.street}, </>}
              {contact.address.short}
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10 px-[15px] pt-10 pb-[50px] text-center text-lg leading-6 sm:px-[30px]">
    <p>
      © {year}{" "}
      <a href="/" class="text-primary hover:text-white">
        {site.name}
      </a>
      . Designed by{" "}
      <a href={site.developer.url} target="_blank" rel="noopener" class="text-primary hover:text-white">
        {site.developer.name}
      </a>
    </p>
  </div>
</footer>
