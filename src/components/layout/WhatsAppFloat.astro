---
/**
 * Floating "Chat with us" WhatsApp button, bottom right on every page (WhatsApp is the main
 * contact channel). The back-to-top button in BaseLayout sits just above it.
 */
import { whatsappLink } from "../../config/site";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";

interface Props {
  /** Pre-filled first message (defaults to the site-wide one in src/config/site.ts). */
  message?: string;
}

const { message } = Astro.props;
---

<a
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener"
  class="group fixed right-[15px] bottom-[15px] z-[996] flex items-center gap-3 sm:right-[30px] sm:bottom-[30px] print:hidden"
  aria-label="Chat with us on WhatsApp"
  data-whatsapp-float
>
  <span
    class="hidden rounded-full bg-white px-4 py-2 text-sm leading-5 font-bold text-secondary shadow-[0_6px_24px_rgba(0,0,0,0.18)] transition-colors group-hover:text-primary-strong sm:block"
    aria-hidden="true"
  >
    Chat with us
  </span>
  <span class="flex size-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-[0_8px_24px_rgba(0,0,0,0.28)] transition-[background-color,transform] duration-300 group-hover:scale-105 group-hover:bg-[#1ebe5b] sm:size-[60px]">
    <WhatsAppIcon class="text-[30px] sm:text-[32px]" />
  </span>
</a>
