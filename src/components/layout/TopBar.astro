---
import { quoteEmailLink, site, socialLinks, whatsappLink } from "../../config/site";
import Icon from "../ui/Icon.astro";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";

const { contact } = site;
---

<div class="flex items-center justify-between gap-5 bg-topbar px-[30px] py-[10px] text-sm leading-[23.33px] font-medium text-white">
  <ul class="hidden items-center gap-[13px] sm:flex">
    <li>
      <a href={quoteEmailLink()} class="flex items-center gap-2 hover:text-primary">
        <Icon name="mail" class="text-base" />
        <span>{contact.email}</span>
      </a>
    </li>
    <li class="hidden items-center gap-[5px] lg:flex">
      <Icon name="time-line" class="mb-[3px] text-[15px]" />
      <span>{contact.hours.short}</span>
    </li>
    <li>
      <a
        href={contact.address.mapUrl}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-[5px] hover:text-primary"
      >
        <Icon name="map" class="mb-[3px] text-[15px]" />
        <span>{contact.address.short}</span>
      </a>
    </li>
  </ul>
  <div class="flex items-center gap-[21px] max-sm:mx-auto sm:ml-auto">
    <a
      href={whatsappLink()}
      target="_blank"
      rel="noopener"
      class="flex items-center gap-2 font-bold hover:text-primary"
    >
      <WhatsAppIcon class="text-base" />
      <span>WhatsApp us</span>
    </a>
    <a href={site.contact.phone.href} class="flex items-center gap-2 hover:text-primary">
      <Icon name="phone" class="text-[15px]" />
      <span>{site.contact.phone.display}</span>
    </a>
    {
      /* Social icons only where the bar has room; the footer shows them at every width. */
      socialLinks.length > 0 && (
        <ul class="-my-1 flex items-center gap-1.5 max-lg:hidden">
          {socialLinks.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={`${site.name} on ${s.label}`}
                class="flex size-6 items-center justify-center hover:text-primary"
              >
                <Icon name={s.icon} class="text-base" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
