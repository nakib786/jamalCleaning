---
/**
 * Fixed bottom bar on ≤1200px (theme template "mobile bar"). The demo's
 * account/cart actions are replaced with Call and Get a Quote for a service business.
 */
import { site } from "../../config/site";
import Icon from "../ui/Icon.astro";
---

<nav
  aria-label="Quick actions"
  class="fixed inset-x-0 bottom-0 z-[990] grid h-[70px] grid-cols-3 bg-white text-secondary shadow-[0_10px_30px_rgba(0,0,0,0.3)] xl:hidden"
>
  <button type="button" class="flex items-center justify-center hover:text-primary" aria-label="Search" data-search-open>
    <Icon name="search-lg" class="text-xl" />
  </button>
  <a href={site.contact.phone.href} class="flex items-center justify-center hover:text-primary" aria-label={`Call ${site.contact.phone.display}`}>
    <Icon name="phone" class="text-xl" />
  </a>
  <a href={site.quote.href} class="flex items-center justify-center hover:text-primary" aria-label={site.quote.label}>
    <Icon name="chat" class="text-xl" />
  </a>
</nav>
