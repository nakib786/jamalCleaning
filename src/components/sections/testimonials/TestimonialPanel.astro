---
/**
 * Photo panel beside testimonials: green fill + faded photo + cleaning team, a notch cut into the
 * top-right corner, and the "Ratings 4.5" card. Hidden on phones, like the theme.
 * The notch is drawn with overlays in the section background colour (`notchColor`).
 */
import { Image } from "astro:assets";
import cleaningBackground from "../../../assets/images/testimonials/cleaning-1.jpg";
import cleaningTeam from "../../../assets/images/testimonials/cleaning-2.png";
import ratingsAvatars from "../../../assets/images/testimonials/ratings.png";

interface Props {
  class?: string;
  notchColor?: string;
}

const { class: className, notchColor = "#fff" } = Astro.props;
---

<div
  class:list={[
    "testimonial-panel relative hidden shrink-0 overflow-hidden rounded-[24px] rounded-tr-none sm:block",
    className,
  ]}
  style={`--notch-color:${notchColor}`}
  data-reveal="right"
>
  <div class="absolute inset-0 bg-primary-strong" aria-hidden="true"></div>
  <Image
    src={cleaningBackground}
    alt=""
    widths={[480, 650, 945]}
    sizes="(min-width: 1201px) 650px, (min-width: 881px) 50vw, 100vw"
    class="absolute inset-0 size-full object-cover opacity-[0.24]"
  />
  <div class="absolute inset-x-0 bottom-0 z-[2] flex justify-center">
    <Image
      src={cleaningTeam}
      alt="Three smiling cleaners in green aprons and yellow gloves holding cleaning supplies"
      widths={[400, 571, 765]}
      sizes="(min-width: 1201px) 571px, (min-width: 1025px) 450px, 400px"
      class="team-photo object-cover"
    />
  </div>
  <div
    class="notch absolute top-0 right-0 z-[3] h-[50px] w-[156px] rounded-bl-[24px]"
    aria-hidden="true"
  ></div>
  <div class="notch-corner absolute top-0 right-[156px] z-[3] size-6" aria-hidden="true"></div>
  <div class="notch-corner absolute top-[50px] right-0 z-[3] size-6" aria-hidden="true"></div>

  <div class="absolute bottom-[30px] left-[30px] z-[4] flex min-h-[200px] w-[370px] max-w-[calc(100%-60px)] flex-col rounded-[24px] bg-[#fefdf4] pt-6 pr-[21px] pb-9 pl-[31px] md:bottom-[37px]">
    <p class="pb-[3px] font-heading text-xl leading-10 text-secondary capitalize">Ratings 4.5</p>
    <p class="pb-[15px] leading-6 font-medium text-[#5c6672]">Clients praise our exceptional work.</p>
    <div class="flex items-center gap-2">
      <Image src={ratingsAvatars} alt="" width={187} class="h-[58px] w-[187px]" />
      <p class="max-w-[123px] text-lg leading-5 font-semibold text-secondary">586k Clients globally</p>
    </div>
  </div>
</div>

<style>
  .testimonial-panel {
    min-height: 720px;
    @media (width <= 1200px) {
      min-height: 630px;
    }
    @media (width <= 1024px) {
      min-height: 531px;
    }
  }
  .team-photo {
    width: 571px;
    height: 653px;
    @media (width <= 1200px) {
      width: 450px;
      height: 550px;
    }
    @media (width <= 1024px) {
      width: 400px;
      height: 450px;
    }
  }
  .notch {
    background-color: var(--notch-color);
  }
  /* Rounds the two outer corners of the notch. */
  .notch-corner {
    background: radial-gradient(circle at 0 100%, transparent 23.5px, var(--notch-color) 24px);
  }
</style>
