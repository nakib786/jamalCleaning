---
/**
 * Layout for the legal pages written in Markdown (src/pages/privacy-policy.md, terms-of-use.md,
 * service-terms.md). Edit the wording in those .md files; this file only sets the page frame and
 * the text styles. Frontmatter: title, description, updated (shown as "Last updated").
 */
import PageTitle from "../components/layout/PageTitle.astro";
import { site } from "../config/site";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: { title: string; description: string; updated: string };
}

const { title, description, updated } = Astro.props.frontmatter;
const legalLinks = [
  { label: "Privacy Policy", href: "/privacy-policy/" },
  { label: "Terms of Use", href: "/terms-of-use/" },
  { label: "Service Terms", href: "/service-terms/" },
];
const current = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <PageTitle title={title} />
  <section class="section-gutter bg-white py-[70px] md:py-[100px]">
    <div class="site-container">
      <div class="mx-auto max-w-[820px]">
        <nav aria-label="Legal pages" class="mb-10 flex flex-wrap gap-x-6 gap-y-2 border-b border-line pb-5">
          {legalLinks.map((link) => (
            <a
              href={link.href}
              aria-current={current === link.href ? "page" : undefined}
              class:list={[
                "font-semibold",
                current === link.href
                  ? "text-secondary"
                  : "text-primary-strong underline underline-offset-2 hover:text-secondary",
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>
        <p class="mb-8 text-sm text-body">
          {site.legalName} · Last updated {updated}
        </p>
        <div class="legal-prose">
          <slot />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-prose {
    color: var(--color-body);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .legal-prose :global(h2) {
    margin: 2.5rem 0 1rem;
    color: var(--color-secondary);
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .legal-prose :global(h3) {
    margin: 1.75rem 0 0.75rem;
    color: var(--color-secondary);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .legal-prose :global(p),
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    margin: 0 0 1.1rem;
  }
  .legal-prose :global(ul) {
    list-style: disc;
    padding-left: 1.4rem;
  }
  .legal-prose :global(ol) {
    list-style: decimal;
    padding-left: 1.4rem;
  }
  .legal-prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .legal-prose :global(strong) {
    color: var(--color-secondary);
  }
  .legal-prose :global(a) {
    color: var(--color-primary-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose :global(a:hover) {
    color: var(--color-secondary);
  }
</style>
