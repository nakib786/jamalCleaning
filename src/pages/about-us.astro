---
/**
 * About: "Why should you choose our services?" with three service highlights and two photos,
 * the marquee, four step cards, the dark "Smart cleaning solution" band with counters, and the
 * testimonial card carousel.
 */
import { Image } from "astro:assets";
import agency1 from "../assets/images/about/agency-1.jpg";
import agency2 from "../assets/images/photos/janitor-vacuuming-office-carpet.jpg";
import agencyDecor from "../assets/images/about/agency-decor.png";
import cleaningTeam from "../assets/images/about/cleaning-team.png";
import step1 from "../assets/images/about/step-1.jpg";
import step2 from "../assets/images/about/step-2.jpg";
import step3 from "../assets/images/about/step-3.jpg";
import step4 from "../assets/images/photos/grocery-store-aisle-polished-floor.jpg";
import bannerImage from "../assets/images/page-title/breadcrumb-about.jpg";
import HouseCleaning from "../assets/images/misc/icons/house-cleaning.svg";
import OfficeCleaning from "../assets/images/misc/icons/office-cleaning.svg";
import StoreCleaning from "../assets/images/misc/icons/store-cleaning.svg";
import PageTitle from "../components/layout/PageTitle.astro";
import TestimonialCards from "../components/sections/testimonials/TestimonialCards.astro";
import Icon from "../components/ui/Icon.astro";
import Marquee from "../components/ui/Marquee.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import WhatsAppIcon from "../components/ui/WhatsAppIcon.astro";
import { site, whatsappLink } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const aboutLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Us",
  url: new URL(Astro.url.pathname, site.url).href,
  mainEntity: { "@id": `${site.url}/#business` },
};

const highlights = [
  {
    icon: StoreCleaning,
    title: "Retail & Big-Box Stores",
    text: "Big-box, department, grocery and apparel stores - sales floors, washrooms and entrances cleaned overnight.",
  },
  {
    icon: OfficeCleaning,
    title: "Offices & Commercial Buildings",
    text: "Offices, clinics, warehouses and multi-tenant buildings - clean, healthy spaces for staff and visitors.",
  },
  {
    icon: HouseCleaning,
    title: "Homes & Move-Outs",
    text: "Regular, deep and move-out cleaning for homeowners, landlords and property managers.",
  },
];

const steps = [
  {
    title: "Tell us about your site",
    text: "Share your store, office or building, your opening hours and what needs cleaning.",
    image: step1,
    alt: "Hand ticking a checklist on a clipboard",
  },
  {
    title: "Walkthrough and quote",
    text: "We walk the site with you and send a clear cleaning plan and quote, with no hidden fees.",
    image: step2,
    alt: "Smiling cleaner in a green uniform in a bright commercial building",
  },
  {
    title: "We clean after hours",
    text: "Trained crews arrive on schedule, equipped, and follow your site checklist every visit.",
    image: step3,
    alt: "Cleaner spraying and wiping glass",
  },
  {
    title: "You open to clean",
    text: "Customers and staff walk into a clean, safe space every day, and you have one contact for it all.",
    image: step4,
    alt: "Long, clean store aisle with stocked shelves and a polished floor",
  },
];

const counters = [
  {
    value: 299,
    suffix: "k",
    title: "Successful Projects",
    text: "Over 250 successful projects delivered with quality and care",
  },
  {
    value: 364,
    suffix: "+",
    title: "Skilled Tradespeople",
    text: "Our team of 30 experts ensures top-quality results",
  },
  {
    value: 199,
    suffix: "+",
    title: "Happy Clients",
    text: "All of our clients are satisfied with our work and service",
  },
];
---

<BaseLayout
  title="About Us"
  description="About Jamal Cleaning Services: commercial janitorial for retail stores, big-box stores, offices and commercial buildings in Prince George, BC, plus residential cleaning. Open 7 days."
  jsonLd={[aboutLd]}
>
  <PageTitle title="About Us" image={bannerImage} />

  <!-- Why choose us ------------------------------------------------------------------------ -->
  <section class="section-gutter relative py-[60px] sm:py-20 md:py-[100px] lg:pt-[139px] lg:pb-[118px]">
    <Image
      src={agencyDecor}
      alt=""
      width={852}
      class="pointer-events-none absolute top-[119px] left-0 hidden opacity-[0.26] min-[1441px]:block"
      aria-hidden="true"
    />
    <div class="site-container relative z-[1] flex flex-col items-center">
      <SectionHeading
        label="About cleaning agency"
        parts={["Why should", { accent: "you choose" }, "our services?"]}
        align="center"
        class="w-full max-w-[880px]"
        labelClass="pb-2.5 sm:pb-[31px]"
        headingClass="pb-[30px] sm:pb-[39px] sm:text-[60px] sm:leading-[90px]"
      />
      <p class="w-[698px] max-w-full pb-[50px] text-center leading-6 sm:pb-[76px]" data-reveal="up">
        Jamal Cleaning Services is a commercial janitorial company in Prince George. Our crews clean retail
        stores, big-box and department stores, offices and commercial buildings after hours, seven days a
        week, and we still look after homes and move-outs for our residential clients.
      </p>

      <div class="flex w-full flex-col gap-[50px] lg:flex-row lg:items-center xl:gap-[81px]">
        <ul class="flex flex-col gap-6 lg:w-[550px] lg:shrink-0 lg:pt-[18px]" data-reveal="up">
          {highlights.map((item, i) => (
            <li
              class:list={[
                "flex items-center gap-[21px]",
                i === 1 && "border-y border-line pt-[30px] pb-[34px]",
                i === 2 && "pt-1.5",
              ]}
            >
              <span class="flex size-20 shrink-0 items-center justify-center rounded-full bg-highlight text-secondary">
                <item.icon class="size-[42px]" aria-hidden="true" />
              </span>
              <span>
                <span class="block font-heading text-base leading-10 text-secondary capitalize">
                  {item.title}
                </span>
                <span class="block leading-6 sm:pr-[52px]">{item.text}</span>
              </span>
            </li>
          ))}
        </ul>
        <div class="flex flex-1 items-center gap-[9px]">
          <Image
            src={agency1}
            alt="Basket of cleaning supplies on a kitchen counter"
            widths={[378, 756]}
            sizes="(min-width: 1025px) 378px, 100vw"
            class="h-[397px] w-full rounded-[24px] object-cover sm:max-md:w-1/2 md:max-lg:w-full lg:w-1/2"
            data-reveal="right"
          />
          <Image
            src={agency2}
            alt="Janitor in yellow gloves vacuuming the carpet in a modern office"
            widths={[378, 756]}
            sizes="(min-width: 1025px) 378px, 50vw"
            class="hidden h-[397px] w-1/2 rounded-[24px] object-cover sm:max-md:block lg:block"
            data-reveal="left"
          />
        </div>
      </div>
    </div>
  </section>

  <Marquee class="pb-[60px] lg:pb-[88px]" />

  <!-- Four steps ------------------------------------------------------------------------------ -->
  <section class="section-gutter bg-surface py-[60px] sm:py-20 md:py-[100px] lg:pt-[120px] lg:pb-[108px]">
    <div class="site-container flex flex-col">
      <SectionHeading
        label="How it works"
        parts={["Get cleaner", { accent: "space in four" }, "steps"]}
        align="center"
        class="mx-auto w-full max-w-[678px] pb-[30px] lg:pb-[60px]"
        labelClass="pb-2.5 sm:pb-[30px]"
      />
      <ol class="grid gap-[30px] sm:grid-cols-2 xl:grid-cols-4">
        {steps.map((step, i) => (
          <li
            class="step-card group relative rounded-[24px] bg-white px-2.5 pt-2.5 pb-[43px]"
            style={`--step-offset:${i * 50}px`}
            data-reveal="up"
            data-reveal-delay={String(i * 100)}
          >
            <div class="relative">
              <div class="relative overflow-hidden rounded-[24px] pb-[64.52%]">
                <Image
                  src={step.image}
                  alt={step.alt}
                  widths={[310, 620]}
                  sizes="(min-width: 1201px) 301px, (min-width: 768px) 50vw, 100vw"
                  class="absolute inset-0 size-full object-cover transition-transform duration-[400ms] ease-in-out group-hover:scale-[1.07]"
                />
              </div>
              <span class="step-bump absolute right-5 bottom-0 z-[3] h-[34px] w-[100px]" aria-hidden="true" />
              <span class="absolute right-11 -bottom-[26px] z-[4] flex size-[52px] items-center justify-center rounded-full bg-primary-strong text-base leading-5 font-bold text-white">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="pt-10 pr-9 pl-[21px]">
              <h3 class="mb-[15px] font-heading text-base leading-[30px] text-secondary capitalize">
                {step.title}
              </h3>
              <p class="leading-6">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Smart cleaning band --------------------------------------------------------------------- -->
  <section class="section-gutter relative overflow-hidden bg-teal pt-[60px] sm:pt-20 md:pt-[100px] lg:min-h-[960px] lg:pt-[130px]">
    <div class="site-container relative flex flex-col gap-[50px] lg:flex-row lg:justify-between lg:gap-10">
      <div class="relative z-[3] flex flex-col max-lg:items-center max-lg:text-center lg:w-[688px]">
        <SectionHeading
          label="Our trusted partner"
          parts={["Smart cleaning", { accent: "solution for you 24/7" }, "hours"]}
          dark
          class="pb-[30px] max-lg:items-center max-lg:text-center"
          labelClass="pb-2.5 sm:pb-[30px]"
          reveal="up"
        />
        <p class="max-w-[480px] pb-[30px] leading-6 text-white" data-reveal="up">
          Overnight janitorial, day porters and floor care under one plan, seven days a week, with one point
          of contact who answers when you message.
        </p>
        <div class="flex flex-wrap items-center gap-[30px] max-lg:justify-center" data-reveal="up">
          <a href="/services/" class="btn btn-md btn-on-dark">
            <span>Explore Our Services</span>
            <span class="btn-icon">
              <Icon name="right-arrow" class="text-base" />
            </span>
          </a>
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-3 text-white"
          >
            <WhatsAppIcon class="text-[30px] transition-colors group-hover:text-highlight" />
            <span class="flex flex-col text-left">
              <span class="text-base leading-[14px] font-semibold capitalize">Chat on WhatsApp</span>
              <span class="mt-1.5 font-heading text-sm leading-4 transition-colors group-hover:text-highlight">
                {site.contact.whatsapp.display}
              </span>
            </span>
          </a>
        </div>
      </div>

      <ul class="relative z-[3] grid gap-[30px] max-lg:text-center sm:grid-cols-3 lg:flex lg:w-[388px] lg:flex-col lg:gap-[60px]">
        {counters.map((c, i) => (
          <li class="lg:min-h-[188px]" data-reveal="up" data-reveal-delay={String(i * 100)}>
            <p class="font-heading text-[50px] leading-[80px] text-white">
              <span data-counter={c.value}>{c.value}</span>
              {c.suffix}
            </p>
            <h3 class="mt-[18px] font-heading text-sm leading-[30px] text-white capitalize">{c.title}</h3>
            <p class="mt-2.5 leading-6 text-white lg:max-w-[309px]">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div
      class="pointer-events-none relative mt-10 flex h-[370px] justify-center sm:h-[490px] lg:absolute lg:inset-0 lg:mt-0 lg:h-auto"
      aria-hidden="true"
    >
      <span class="brand-watermark absolute top-[150px] left-1/2 -translate-x-1/2 font-heading text-[120px] leading-[1.06] whitespace-nowrap uppercase sm:top-[200px] sm:text-[220px] lg:top-[693px] lg:text-[330px]">
        Jamal
      </span>
      <Image
        src={cleaningTeam}
        alt=""
        widths={[400, 521]}
        sizes="(min-width: 1025px) 505px, 80vw"
        class="absolute bottom-0 left-1/2 z-[2] w-[300px] -translate-x-1/2 sm:w-[400px] lg:ml-[35px] lg:w-[505px]"
      />
    </div>
  </section>

  <TestimonialCards />
</BaseLayout>

<style>
  @media (width >= 1201px) {
    .step-card {
      margin-top: var(--step-offset);
      align-self: start;
    }
  }
  /* White hump behind the step number (theme .decor-border). */
  .step-bump::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100px;
    height: 33px;
    background-color: #fff;
    clip-path: path(
      "M 0 33 H 100 C 86 33 85 33 79 19 C 75 6 60.6183 0 51 0 C 37.3818 0 26.4011 6.9412 20.7412 19.1769 C 16.3213 33.1703 15 33 0 33 Z"
    );
  }
  /* Big brand word fading out downwards (theme heading "text gradient"). */
  .brand-watermark {
    background: linear-gradient(180deg, var(--color-primary) 0%, rgba(212, 170, 60, 0) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
