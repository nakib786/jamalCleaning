---
import PageTitle from "../components/layout/PageTitle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex>
  <PageTitle title="404" crumbs={[{ label: "Page not found" }]} />
  <section class="section-gutter py-[120px]">
    <div class="site-container text-center">
      <p class="text-lg">This page is being rebuilt to match the reference design.</p>
    </div>
  </section>
</BaseLayout>
