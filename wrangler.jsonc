// Cloudflare Workers with static assets — Cloudflare's recommended setup for new static/hybrid sites.
// `astro build` writes the site to ./dist; the Worker in worker/index.ts only runs for /api/*.
// See DEPLOY.md for first deploy, custom domain, secrets and rollback.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jamal-cleaning-site",
  // Manpreetjamal56@gmail.com's Account (the login can see several accounts).
  "account_id": "ddcccb58eab0c262a67bebb4c9dfe733",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pages are built as /about-us/index.html, so /about-us redirects to /about-us/ (matches canonical URLs).
    "html_handling": "force-trailing-slash",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only form endpoints invoke the Worker; everything else is served directly from the asset cache.
    "run_worker_first": ["/api/*"],
  },

  // Form submissions are emailed through Email Routing: a Worker may send (free, any plan) to a
  // verified destination address. The binding is locked to that address.
  "send_email": [{ "name": "EMAIL", "destination_address": "n@aurorabusiness.ca" }],

  // Non-secret settings. Secrets (TURNSTILE_SECRET_KEY) are set with `wrangler secret put`.
  "vars": {
    "SITE_NAME": "Jamal Cleaning Services",
    "EMAIL_TO": "n@aurorabusiness.ca",
    "EMAIL_FROM": "website@jmcleaningservice.ca",
    // Wix Headless project that stores contacts, quote/contact submissions and newsletter subscribers.
    // Public client id (not a secret). Dashboard: https://manage.wix.com/dashboard/8f5da4c3-3c27-477e-9c65-15ddd1c6ff10
    // Previews below leave it out on purpose, so test submissions never reach the real CRM.
    "WIX_CLIENT_ID": "73a65d85-7e38-4734-a981-91af64a28fca",
  },

  // Used by `wrangler preview` (Cloudflare Workers Builds for non-production branches and pull requests).
  // Previews must not touch production settings, so they only ever email the testing address,
  // whatever EMAIL_TO / send_email are switched to for the live site.
  "previews": {
    "vars": {
      "SITE_NAME": "Jamal Cleaning Services (preview)",
      "EMAIL_TO": "n@aurorabusiness.ca",
      "EMAIL_FROM": "website@jmcleaningservice.ca",
    },
    "send_email": [{ "name": "EMAIL", "destination_address": "n@aurorabusiness.ca" }],
  },

  "observability": { "enabled": true },

  // workers.dev URL and per-version preview URLs stay on for testing before the custom domain is live.
  "workers_dev": true,
  "preview_urls": true,

  // Added when the domain is connected (DEPLOY.md, step 5):
  // "routes": [
  //   { "pattern": "jmcleaningservice.ca", "custom_domain": true },
  //   { "pattern": "www.jmcleaningservice.ca", "custom_domain": true }
  // ],
}
